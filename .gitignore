# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files（.env.example 是模板，必须入库；真实值一律不提交）
.env*
!.env.example

# 编辑器专属的 skills 副本。Prisma 会把同一份 skills 装到 .agents、.claude 和
# .windsurf 三处，仓库只保留 .agents 这一份厂商中立的副本。
.claude/
.windsurf/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma
