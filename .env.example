# 复制本文件为 .env 后填入真实值。.env 已被 .gitignore 忽略，不要提交。
# 该文件同时被 docker compose 和 Next.js 读取。

# ---------- 基础设施（docker compose 使用） ----------
# 本地开发可直接沿用下列默认值；部署到服务器时必须全部替换为强随机密码。
MYSQL_ROOT_PASSWORD=devroot
MYSQL_DATABASE=document_online
MYSQL_USER=app
MYSQL_PASSWORD=devpass
# 容器 MySQL 映射到宿主机的端口。刻意避开 3306（开发机常有本机 MySQL）和
# 3307/3308（本机上其他项目的容器已占用）。端口冲突时容器会启动失败，
# 换一个空闲端口并同步下面的 DATABASE_URL 即可。
MYSQL_PORT=3309
# 同理避开 6379（开发机常有本机 Redis）和 6380（本机其他项目容器已占用）。
REDIS_PORT=6381

# ---------- 应用（Next.js 使用） ----------
# MySQL 连接串。用户名密码需与上面的 MYSQL_USER / MYSQL_PASSWORD 一致，
# 端口需与 MYSQL_PORT 一致。
# 主机请用 127.0.0.1：Windows 上 localhost 可能走 IPv6(::1)，而 compose 只绑 127.0.0.1。
DATABASE_URL="mysql://app:devpass@127.0.0.1:3309/document_online"

# 仅本地开发需要。`prisma migrate dev` 要用影子数据库演算迁移，这需要
# CREATE DATABASE 权限，而应用账号刻意不具备该权限。
# 影子库必须是独立库名，不能与 DATABASE_URL 指向同一库（否则 migrate dev 可能清空开发数据）。
# 生产环境用 `prisma migrate deploy`，不需要影子库，务必不要设置本变量。
SHADOW_DATABASE_URL="mysql://root:devroot@127.0.0.1:3309/document_online_shadow"

# Redis 连接串。用于浏览量计数、接口限流与分享链接密码会话。
# 端口需与上面的 REDIS_PORT 一致。
REDIS_URL="redis://localhost:6381"

# 会话 JWT 的签名密钥，至少 32 字节随机值。
# 生成方式：openssl rand -base64 32
# 切勿使用下面这个占位值，它只是格式示例。
SESSION_SECRET="REPLACE_ME_WITH_OPENSSL_RAND_BASE64_32"

# 站点对外基地址，用于生成分享链接和 og 标签。
# 本地开发用 http://localhost:3000；上线后必须是 https 的正式域名，
# 否则分享链接在微信内会被拦截。
APP_BASE_URL="http://localhost:3000"
